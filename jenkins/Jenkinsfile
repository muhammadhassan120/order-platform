pipeline {
  agent any

  environment {
    AWS_REGION     = 'us-east-2'
    ECR_REPOSITORY = 'order-platform-repo'
    ECS_CLUSTER    = 'order-platform-cluster'
    ECS_SERVICE    = 'order-platform-service'
    TASK_CONTAINER = 'order-api'
    LAMBDA_FUNCTION = 'order-platform-order-processor'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
        script {
          env.GIT_COMMIT_SHORT = sh(
            returnStdout: true,
            script: 'git rev-parse --short HEAD'
          ).trim()
          env.AWS_ACCOUNT_ID = sh(
            returnStdout: true,
            script: 'aws sts get-caller-identity --query Account --output text'
          ).trim()
          env.ECR_REPO = "${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_REGION}.amazonaws.com/${env.ECR_REPOSITORY}"
          env.IMAGE_TAG = "${env.BUILD_NUMBER}-${env.GIT_COMMIT_SHORT}"
        }
      }
    }

    stage('Test: Order API') {
      steps {
        sh '''
          set -e
          docker run --rm \
            -v "$PWD:/workspace" \
            -w /workspace/services/order-api \
            node:20-alpine \
            sh -lc 'npm ci && npm test'
        '''
      }
    }

    stage('Test & Package: Lambda') {
      steps {
        sh '''
          set -e
          python3 -m pip install --user pytest || true
          python3 -m pytest services/order-processor/tests
          chmod +x scripts/package-lambda.sh
          PYTHON_BIN=python3 ./scripts/package-lambda.sh
        '''
      }
    }

    stage('Build & Push: Order API') {
      steps {
        dir('services/order-api') {
          sh '''
            set -e
            aws ecr get-login-password --region ${AWS_REGION} | \
              docker login --username AWS --password-stdin ${ECR_REPO}

            docker build \
              -t ${ECR_REPO}:${IMAGE_TAG} \
              -f Dockerfile .

            docker push ${ECR_REPO}:${IMAGE_TAG}
          '''
        }
      }
    }

    stage('Deploy: Lambda') {
      steps {
        sh '''
          set -e
          cd infra/modules/async/lambda_build
          zip -qr ../lambda_function.zip .
          aws lambda update-function-code \
            --region ${AWS_REGION} \
            --function-name ${LAMBDA_FUNCTION} \
            --zip-file fileb://../lambda_function.zip
        '''
      }
    }

    stage('Deploy: ECS') {
      steps {
        sh '''
          chmod +x jenkins/scripts/deploy.sh
          AWS_REGION=${AWS_REGION} \
          ECR_REPO=${ECR_REPO} \
          IMAGE_TAG=${IMAGE_TAG} \
          ECS_CLUSTER=${ECS_CLUSTER} \
          ECS_SERVICE=${ECS_SERVICE} \
          TASK_CONTAINER=${TASK_CONTAINER} \
          ./jenkins/scripts/deploy.sh
        '''
      }
    }

    stage('Smoke Test') {
      steps {
        sh '''
          chmod +x jenkins/scripts/smoke-test.sh
          AWS_REGION=${AWS_REGION} \
          ECS_CLUSTER=${ECS_CLUSTER} \
          ECS_SERVICE=${ECS_SERVICE} \
          ./jenkins/scripts/smoke-test.sh
        '''
      }
    }

    stage('Archive') {
      steps {
        echo 'Skipping archive upload for now'
      }
    }
  }

  post {
    success {
      echo "Pipeline #${BUILD_NUMBER} PASSED - image: ${IMAGE_TAG}"
    }
    failure {
      echo "Pipeline #${BUILD_NUMBER} FAILED"
    }
    always {
      cleanWs()
    }
  }
}
