pipeline {
  agent any

  parameters {
    choice(name: 'ACTION', choices: ['plan', 'apply', 'destroy'], description: 'Terraform action')
    choice(name: 'ENVIRONMENT', choices: ['dev'], description: 'Terraform environment')
  }

  environment {
    AWS_REGION = 'us-east-2'
    TF_STATE_BUCKET_PREFIX = 'order-platform-tfstate'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Package Lambda') {
      steps {
        sh '''
          set -e
          chmod +x scripts/package-lambda.sh
          PYTHON_BIN=python3 ./scripts/package-lambda.sh
        '''
      }
    }

    stage('Terraform Init') {
      steps {
        dir('infra') {
          sh '''
            set -euo pipefail
            AWS_ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)
            TF_STATE_BUCKET="${TF_STATE_BUCKET_PREFIX}-${AWS_ACCOUNT_ID}"

            if ! aws s3api head-bucket --bucket "${TF_STATE_BUCKET}" 2>/dev/null; then
              aws s3api create-bucket \
                --bucket "${TF_STATE_BUCKET}" \
                --region "${AWS_REGION}" \
                --create-bucket-configuration LocationConstraint="${AWS_REGION}"
            fi

            aws s3api put-bucket-versioning \
              --bucket "${TF_STATE_BUCKET}" \
              --versioning-configuration Status=Enabled

            cat > backend.generated.tf <<'EOF'
terraform {
  backend "s3" {}
}
EOF

            terraform init -reconfigure \
              -backend-config="bucket=${TF_STATE_BUCKET}" \
              -backend-config="key=${ENVIRONMENT}/terraform.tfstate" \
              -backend-config="region=${AWS_REGION}"
          '''
        }
      }
    }

    stage('Terraform Plan') {
      steps {
        dir('infra') {
          sh 'terraform plan -input=false -var-file=environments/${ENVIRONMENT}.tfvars -out=tfplan'
        }
      }
    }

    stage('Manual Approval') {
      when {
        expression { params.ACTION == 'apply' || params.ACTION == 'destroy' }
      }
      steps {
        input message: "Review the plan above. Proceed with '${params.ACTION}' for ${params.ENVIRONMENT}?",
              ok: "Yes, ${params.ACTION}"
      }
    }

    stage('Terraform Apply') {
      when {
        expression { params.ACTION == 'apply' }
      }
      steps {
        dir('infra') {
          sh 'terraform apply -input=false tfplan'
        }
      }
    }

    stage('Terraform Destroy') {
      when {
        expression { params.ACTION == 'destroy' }
      }
      steps {
        dir('infra') {
          sh 'terraform destroy -input=false -var-file=environments/${ENVIRONMENT}.tfvars -auto-approve'
        }
      }
    }
  }
}
